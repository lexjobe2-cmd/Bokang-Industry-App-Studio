# Redis is optional. Apps must degrade gracefully when it is not configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google user-owned data plane
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft user-owned data plane
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=

# Runtime
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_SLUG=lex-intake
APP_ENCRYPTION_SECRET=
